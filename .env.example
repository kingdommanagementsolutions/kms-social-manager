# ---- Core -------------------------------------------------------------
PORT=3000
# Interface to listen on. Keep 127.0.0.1 when nginx fronts the app.
HOST=127.0.0.1
# Public URL of this dashboard, e.g. http://203.0.113.10/kms-social-dashboard (server IP + path, no trailing slash).
# Public URL of this dashboard. OAuth redirect URIs are BASE_URL + /auth/<platform>/callback
# and uploaded media is served from BASE_URL + /media/... (platforms must be able to reach it).
BASE_URL=http://localhost:3000
# Set a password to protect the dashboard (strongly recommended anywhere but localhost).
DASHBOARD_PASSWORD=
# Encrypts stored access tokens. If blank, a random key is generated in data/.secret
APP_SECRET=

# ---- Platform API credentials ------------------------------------------
# Preferred: enter these in the dashboard (Accounts > API credentials). They are stored
# encrypted in the SQLite database. Anything set here is imported into the database on
# first start (after which you can delete it from this file).
# META_APP_ID= META_APP_SECRET=
# X_CLIENT_ID= X_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY= TIKTOK_CLIENT_SECRET= TIKTOK_PRIVACY=SELF_ONLY
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET=
