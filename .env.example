# ---- Core -------------------------------------------------------------
PORT=3000
# Interface to listen on. Keep 127.0.0.1 when nginx fronts the app.
HOST=127.0.0.1
# Public URL of this dashboard, e.g. http://203.0.113.10 (your server IP, no trailing slash).
# Public URL of this dashboard. OAuth redirect URIs are BASE_URL + /auth/<platform>/callback
# and uploaded media is served from BASE_URL + /media/... (platforms must be able to reach it).
BASE_URL=http://localhost:3000
# Set a password to protect the dashboard (strongly recommended anywhere but localhost).
DASHBOARD_PASSWORD=
# Encrypts stored access tokens. If blank, a random key is generated in data/.secret
APP_SECRET=

# ---- Meta (Facebook Pages + Instagram Business) -----------------------
META_APP_ID=
META_APP_SECRET=

# ---- X (OAuth 2.0 with PKCE) ------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- TikTok (Content Posting API) -------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps can only post privately: SELF_ONLY. After audit use PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY=SELF_ONLY

# ---- LinkedIn ---------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
